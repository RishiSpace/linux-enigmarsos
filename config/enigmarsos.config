# EnigmarsOS LTS kernel configuration fragment
# Applied on top of the Arch linux-lts x86_64 config. Do not use this file alone.
#
# Every option here is documented in config/CONFIG_CHANGES.md.
# Keep this file as small as possible.

# Do not compile for the build machine. ISA floor is x86-64-v2, set in
# PKGBUILD by rewriting arch/x86/Makefile (-march=x86-64-v2).
# CONFIG_X86_NATIVE_CPU is not set

# Primary EnigmarsOS modification: BORE scheduler
CONFIG_SCHED_BORE=y

# BORE base-slice floor (nanoseconds). Matches the patch Kconfig default.
CONFIG_MIN_BASE_SLICE_NS=2000000
